# Maintainer: Isaac Overacker <isaac@overacker.me>
pkgname=deadwax
pkgver=1.0.0
pkgrel=1
pkgdesc='Terminal music player for Navidrome and other Subsonic servers'
arch=('x86_64' 'aarch64')
url='https://github.com/voidrender/deadwax'
license=('MIT OR Apache-2.0')
depends=('mpv' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('gnome-keyring: store the password in the Secret Service keychain'
            'kwallet: store the password in the Secret Service keychain')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The release workflow fills in pkgver and sha256sums (scripts/release/render-pkgbuild.sh).
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/deadwax -t "$pkgdir/usr/bin/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
